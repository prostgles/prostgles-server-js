{
	"files": ["index.ts"],
	"compilerOptions": {
		"target": "es2022",
		"lib": [ "es2022", "DOM" ],
		"esModuleInterop" : true,
		"module": "commonjs",
		"ignoreDeprecations": "5.0",
		"skipLibCheck": true,
		"strictNullChecks": true,
		"noUncheckedIndexedAccess": true,
    "outDir": "dist",
	},
	"exclude": [
		"dist"
	],
	"include": [
		"./**.ts"
	]
}