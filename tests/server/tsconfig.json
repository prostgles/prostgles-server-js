{
	"files": ["./index.ts"],
	"compilerOptions": {
		"target": "es2022",
		"lib": [ "es2022" ],
		"esModuleInterop" : true,
		"allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
		"allowJs": true,
		"module": "node16",
    "moduleResolution": "node16",
		"declaration": true,
		"declarationMap": true, 
		"ignoreDeprecations": "5.0",
		"skipLibCheck": true,
    "rootDir": "..",
    "outDir": "dist"
	},
	"exclude": [
		"dist",
		"DBoGenerated.d.ts"
	]
}