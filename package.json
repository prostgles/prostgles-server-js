{
  "name": "prostgles-server",
  "version": "4.2.659",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "directories": {
    "dist": "dist"
  },
  "scripts": {
    "prepare": "npm run build",
    "start": "tsc --watch",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/server && tsc --noEmit -p tests/client",
    "lint": "eslint . --ext .ts --quiet",
    "test:setup": "npm ci --prefix tests/client && npm ci --prefix tests/server && npm ci --prefix docs/utils",
    "test:lib": "rm -rf ./dist && npm run lint -- --ignore-pattern tests && tsc && node --trace-uncaught --test dist/**/*.spec.js",
    "test:e2e": "cd tests/ && ./test.sh",
    "test": "npm run test:lib && npm run test:e2e && npm run generate-docs",
    "generate-docs": "rm -f ./docs/*.md && cd docs/utils && npm start",
    "release": "npm version patch && git push --follow-tags && npm publish",
    "circular-deps": "tsc && npx madge --circular  ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prostgles/prostgles-server-js.git"
  },
  "author": "Stefan L",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/prostgles/prostgles-server-js/issues"
  },
  "keywords": [
    "postgres",
    "postgreSQL",
    "react",
    "typescript",
    "realtime"
  ],
  "homepage": "https://prostgles.com",
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1149.0",
    "@aws-sdk/credential-provider-node": "^3.972.85",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-microsoft": "^1.0.3",
    "check-disk-space": "^3.4.0",
    "file-type": "^18.7.0",
    "nodemailer": "^9.1.1",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^2.1.0",
    "passport-oauth2": "^1.8.0",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "pg-promise": "^12.7.1",
    "prostgles-types": "^4.0.297"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/express": "^4.17.25",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/sharp": "^0.30.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "socket.io": "^4.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
